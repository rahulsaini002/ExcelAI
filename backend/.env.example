# Copy this file to .env and fill in your real key.
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Model used for instruction -> operation-plan parsing.
# Parsing is an easy task, so a fast low-cost tier is used by default.
SUMIO_MODEL=gemini-2.5-flash

# Comma-separated list of origins allowed to call this API.
# In dev the Next.js app runs on http://localhost:3000
SUMIO_CORS_ORIGINS=http://localhost:3000

# Allow ANY origin (dev convenience: localhost / 127.0.0.1 / LAN IP). Default 1.
# Set to 0 in PRODUCTION so only the origins in SUMIO_CORS_ORIGINS are allowed.
SUMIO_CORS_ALLOW_ALL=1

# Lookup formula style written into .xlsx downloads:
#   index_match  -> works in ALL Excel versions and Google Sheets (default)
#   xlookup      -> cleaner, but needs Excel 2021/365 or Google Sheets
SUMIO_LOOKUP_STYLE=index_match

# --- Pre-deploy hardening (leave blank / 0 for local dev) ---
# Require an API key on every request (except /health). Use the SAME value in the
# frontend's NEXT_PUBLIC_API_TOKEN and the Sheets add-on's SUMIO_API_TOKEN property.
SUMIO_API_TOKEN=
# Per-IP rate limit: max requests per window seconds (0 = unlimited; ~60 is a sane public default).
SUMIO_RATE_LIMIT=0
SUMIO_RATE_WINDOW=60

# --- Database / persistence ---
# Where accounts + the runtime stores (connections/schedules/workspaces/syncs) are saved.
# Leave BLANK for local dev -> a local SQLite file (sumio.db), and persistence stays OFF.
# In production set this to your Postgres URL (Render provides one). Persistence then turns
# ON automatically, so data survives restarts. (Render's "postgres://" prefix is fine.)
DATABASE_URL=
# Force persistence on/off regardless of DATABASE_URL (1/0). Usually leave blank.
SUMIO_PERSIST=

# --- Auth ---
# Signs login tokens. MUST be a long random secret in production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SUMIO_JWT_SECRET=dev-only-insecure-change-me
# How long a login lasts before re-signin (hours). Default 168 = 7 days.
SUMIO_JWT_EXPIRE_HOURS=168
# Google sign-in: OAuth 2.0 Web Client ID from Google Cloud Console (blank disables it).
# Put the SAME value in the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID.
SUMIO_GOOGLE_CLIENT_ID=
# Require sign-in for the whole app (1) or allow anonymous use (0, default). When 1,
# every request except /health, /auth/*, and GET /download/* needs a valid login token.
# Server callers (Sheets add-on, run_due cron) authenticate with SUMIO_API_TOKEN instead.
# IMPORTANT with 1: keep SUMIO_API_TOKEN server-only — do NOT mirror it into the
# frontend's NEXT_PUBLIC_API_TOKEN (it ships in the public bundle and would let anyone
# bypass the login wall).
SUMIO_REQUIRE_AUTH=0

# Where the web app lives — used to build the links we email (password reset, team
# invites) and where OIDC SSO redirects back to. Defaults to the first SUMIO_CORS_ORIGINS
# entry, so usually no need to set it in dev.
SUMIO_FRONTEND_URL=

# Public base URL of THIS backend. Used to build the OIDC callback URL when
# SUMIO_OIDC_REDIRECT_URI is blank. Local dev default: http://localhost:8000
SUMIO_BACKEND_URL=

# --- Enterprise SSO (OpenID Connect) — blank = SSO disabled ---
# Works with any OIDC provider: Okta, Azure AD / Entra, Auth0, Google Workspace, Keycloak.
# Set all three to show the "Continue with SSO" button on the login page. The issuer is the
# base URL that serves /.well-known/openid-configuration, e.g.
#   Okta:   https://YOUR_ORG.okta.com
#   Auth0:  https://YOUR_TENANT.us.auth0.com
#   Azure:  https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
SUMIO_OIDC_ISSUER=
SUMIO_OIDC_CLIENT_ID=
SUMIO_OIDC_CLIENT_SECRET=
# The redirect/callback URL you registered at the IdP. Leave blank to use
# SUMIO_BACKEND_URL + /auth/oidc/callback.
SUMIO_OIDC_REDIRECT_URI=

# --- Delivery transports (blank = delivery disabled, reported clearly) ---
# Email (SMTP) — powers password-reset links, the weekly activity digest, team-invite
# emails, AND scheduled report delivery. Each degrades gracefully when unset (reports
# "email not configured" instead of failing). Common providers: Gmail (smtp.gmail.com:587,
# use an App Password), SendGrid (smtp.sendgrid.net:587, user "apikey"), Postmark, SES.
SUMIO_SMTP_HOST=
SUMIO_SMTP_PORT=587
SUMIO_SMTP_USER=
SUMIO_SMTP_PASSWORD=
SUMIO_SMTP_FROM=
# Slack OUTBOUND delivery (scheduled reports) via an incoming-webhook URL:
SUMIO_SLACK_WEBHOOK=
# Slack slash command (/sumio …): the app's Signing Secret (Slack app → Basic Information
# → App Credentials). Enables POST /slack/command; blank leaves it disabled. This is
# INBOUND and separate from SUMIO_SLACK_WEBHOOK above.
SUMIO_SLACK_SIGNING_SECRET=

# --- Connectors ---
# Live DB/SaaS drivers are wired in app/drivers.py. Postgres works out of the box
# (psycopg2-binary is in requirements). For others, install the optional client:
#   MySQL     -> pip install PyMySQL
#   Snowflake -> pip install snowflake-connector-python
# Credentials are supplied per-connection via the API, not here.
